@page "/"
@page "/events"
@using TeslaCamViewer.Data
@using TeslaCamViewer.Shared
@using Microsoft.EntityFrameworkCore
@using System.Globalization

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-2">
    <MudText Typo="Typo.h5" Class="mb-2">Filtered Events</MudText>

    @if (isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="pa-8">
            <MudProgressCircular Indeterminate Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h6">Loading events...</MudText>
        </MudStack>
    }
    else
    {
        <MudGrid Spacing="2">
            <!-- Left Column: Event List with Filters -->
            <MudItem xs="12" md="4" lg="3">
                <MudPaper Class="pa-3 event-list-panel" Elevation="3">
                    <MudStack Spacing="2">
                        <!-- Filter Controls -->
                        <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="false">
                            <MudText Typo="Typo.h6" Align="Align.Center">Filter Events</MudText>
                        </MudHidden>
                        
                        <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="false">
                            <MudSelect T="string" 
                                       Label="City" 
                                       Value="@filterCity" 
                                       ValueChanged="OnCityFilterChanged"
                                       Clearable="true"
                                       AdornmentIcon="@Icons.Material.Filled.LocationCity"
                                       AdornmentColor="Color.Primary"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense">
                                @foreach (var city in _availableCities)
                                {
                                    <MudSelectItem Value="@city">@city</MudSelectItem>
                                }
                            </MudSelect>
                        </MudHidden>

                        <MudDatePicker Label="Date" 
                                       Date="@filterDate"
                                       DateChanged="OnDateFilterChanged"
                                       Clearable="true"
                                       AdornmentIcon="@Icons.Material.Filled.CalendarToday"
                                       AdornmentColor="Color.Primary"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       IsDateDisabledFunc="IsNotEventDate"
                                       AdditionalDateClassesFunc="GetDateStyle" />

                        <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="false">
                            <MudSelect T="string" 
                                       Label="Source" 
                                       Value="@filterSource" 
                                       ValueChanged="OnSourceFilterChanged"
                                       Clearable="true"
                                       AdornmentIcon="@Icons.Material.Filled.Source"
                                       AdornmentColor="Color.Primary"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense">
                                @foreach (var source in _availableSources)
                                {
                                    <MudSelectItem Value="@source">@source</MudSelectItem>
                                }
                            </MudSelect>
                        </MudHidden>
                        
                        @if (!string.IsNullOrEmpty(filterCity) || filterDate.HasValue || !string.IsNullOrEmpty(filterSource))
                        {
                            <MudButton OnClick="ClearAllFilters" 
                                       Variant="Variant.Outlined" 
                                       Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.Clear"
                                       Size="Size.Small"
                                       FullWidth="true">
                                Clear All Filters
                            </MudButton>
                        }

                        <MudDivider />

                        <!-- Event Count -->
                        <MudText Typo="Typo.subtitle1" Align="Align.Center">
                            Events (@_filteredEvents.Count)
                        </MudText>

                        <!-- Event List -->
                        @if (_filteredEvents.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                                No events found matching the filters.
                            </MudText>
                        }
                        else
                        {
                            @foreach (var clipItem in _filteredEvents)
                            {
                                var isSelected = _selectedEvent?.Event.Id == clipItem.Event.Id;
                                <MudPaper Elevation="@(isSelected ? 8 : 4)" 
                                          Class="@($"teslacam-card drawer-section {(isSelected ? "selected-event" : "")}")"
                                          Style="@(isSelected ? "border: 2px solid var(--mud-palette-primary);" : "")">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="teslacam-row">

                                        <!-- Thumb -->
                                        <div class="teslacam-thumb-wrap">
                                            <MudImage Src="@clipItem.ThumbnailUrl"
                                                      Alt="clip thumbnail"
                                                      Class="teslacam-thumb"
                                                      ObjectFit="ObjectFit.Cover" />
                                        </div>

                                        <!-- Info -->
                                        <div class="teslacam-info">
                                            <MudText Typo="Typo.h6" Class="teslacam-title">@clipItem.Event?.Source</MudText>
                                            <MudText Typo="Typo.body2" Class="teslacam-sub">@clipItem.Event?.City</MudText>
                                        </div>

                                        <!-- Right -->
                                        <div class="teslacam-right">
                                            <div class="teslacam-meta">
                                                <MudText Typo="Typo.subtitle1" Class="teslacam-time">
                                                    @(clipItem.Event.TimeStamp.ToLocalTime().ToString("HH:mm:ss") ?? "")
                                                </MudText>
                                                <MudText Typo="Typo.caption" Class="teslacam-day">
                                                    @(clipItem.Event.TimeStamp.ToLocalTime().ToString("ddd") ?? "")
                                                </MudText>
                                            </div>

                                            <MudButton OnClick="() => OnClipClicked(clipItem)"
                                                       Color="@(isSelected ? Color.Secondary : Color.Primary)"
                                                       Variant="Variant.Filled"
                                                       Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.PlayArrow"
                                                       Class="teslacam-show">
                                                @(isSelected ? "Playing" : "Show")
                                            </MudButton>
                                        </div>

                                    </MudStack>
                                </MudPaper>
                            }
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>

            <!-- Right Column: Video Player -->
            <MudItem xs="12" md="8" lg="9">
                @if (_selectedEvent is not null)
                {
                    @if (isLoadingCameras)
                    {
                        <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="pa-8">
                            <MudProgressCircular Indeterminate Color="Color.Primary" Size="Size.Large" />
                            <MudText Typo="Typo.h6">Loading cameras...</MudText>
                        </MudStack>
                    }
                    else
                    {
                        <!-- Event Layout with Map and Timeline -->
                        <MudStack Spacing="2">
                            
                            <!-- Row 1: Map and Timeline side by side -->
                            <MudGrid Spacing="2">
                                <!-- Left: Event Location Map -->
                                @if (!string.IsNullOrEmpty(_selectedEvent?.Event?.Lat) && !string.IsNullOrEmpty(_selectedEvent?.Event?.Long))
                                {
                                    <!-- Mobile: show address only -->
                                    <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="true">
                                        <MudItem xs="12">
                                            <MudPaper Class="pa-2" Elevation="3">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Justify="Justify.Center">
                                                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Color="Color.Primary" />
                                                    <MudText Typo="Typo.body2">
                                                        @(_selectedEvent?.Event?.Street)@(!string.IsNullOrEmpty(_selectedEvent?.Event?.Street) && !string.IsNullOrEmpty(_selectedEvent?.Event?.City) ? ", " : "")@(_selectedEvent?.Event?.City)
                                                    </MudText>
                                                </MudStack>
                                            </MudPaper>
                                        </MudItem>
                                    </MudHidden>

                                    <!-- Desktop: show full map -->
                                    <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="false">
                                        <MudItem xs="12" md="6" lg="4">
                                            <MudPaper Class="pa-2 event-map" Elevation="3">
                                                <MudStack Spacing="1">
                                                    <MudText Typo="Typo.subtitle2" Align="Align.Center">Event Location</MudText>
                                                    <div id="event-map" class="event-map-canvas" style="height: 280px; width: 100%; border-radius: 6px;"></div>
                                                    @if (!string.IsNullOrEmpty(_selectedEvent?.Event?.City))
                                                    {
                                                        <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Secondary">
                                                            @_selectedEvent.Event.City
                                                        </MudText>
                                                    }
                                                    @if (!string.IsNullOrEmpty(_selectedEvent?.Event?.Street))
                                                    {
                                                        <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Secondary">
                                                            @_selectedEvent.Event.Street
                                                        </MudText>
                                                    }
                                                </MudStack>
                                            </MudPaper>
                                        </MudItem>
                                    </MudHidden>
                                }

                                <!-- Right: Timeline -->
                                @if (cameras != null && cameras.Count > 0)
                                {
                                    <MudItem xs="12" md="@(!string.IsNullOrEmpty(_selectedEvent?.Event?.Lat) && !string.IsNullOrEmpty(_selectedEvent?.Event?.Long) ? 6 : 12)" 
                                             lg="@(!string.IsNullOrEmpty(_selectedEvent?.Event?.Lat) && !string.IsNullOrEmpty(_selectedEvent?.Event?.Long) ? 8 : 12)">
                                        <MudPaper Class="pa-2 timeline-panel" Elevation="3">
                                            <MudStack Spacing="1">
                                                <MudText Typo="Typo.subtitle2" Align="Align.Center">Timeline</MudText>
                                                
                                                <!-- Playback Controls Row -->
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Justify="Justify.Center">
                                                    <MudIconButton Icon="@Icons.Material.Filled.FastRewind"
                                                                   Color="Color.Default"
                                                                   Size="Size.Small"
                                                                   OnClick="SkipBackward"
                                                                   title="Back 5 seconds (←)"
                                                                   aria-label="Skip backward 5 seconds" />

                                                    <MudIconButton Icon="@(isPlaying? Icons.Material.Filled.Pause : Icons.Material.Filled.PlayArrow)"
                                                                   Color="@(isPlaying ? Color.Secondary : Color.Primary)"
                                                                   Size="Size.Small"
                                                                   OnClick="TogglePlayPause"
                                                                   title="Play/pause (Space)"
                                                                   aria-label="@(isPlaying ? "Pause" : "Play")" />

                                                    <MudIconButton Icon="@Icons.Material.Filled.FastForward"
                                                                   Color="Color.Default"
                                                                   Size="Size.Small"
                                                                   OnClick="SkipForward"
                                                                   title="Forward 5 seconds (→)"
                                                                   aria-label="Skip forward 5 seconds" />

                                                    @if (minTimestamp.HasValue && _selectedEvent?.Event is not null)
                                                    {
                                                        <MudIconButton Icon="@Icons.Material.Filled.Flag"
                                                                       Color="Color.Error"
                                                                       Size="Size.Small"
                                                                       OnClick="JumpToEventTrigger"
                                                                       title="Jump to event"
                                                                       aria-label="Jump to event trigger" />
                                                    }
                                                </MudStack>
                                                <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="false">
                                                    <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Secondary">
                                                        Space play · ← → 5s · click marker to jump
                                                    </MudText>
                                                </MudHidden>

                                                <!-- Slider Row -->
                                                <div style="width: 100%; position: relative;">
                                                    <MudSlider T="double"
                                                               Value="@currentTime"
                                                               Min="0"
                                                               Max="@videoDuration"
                                                               Step="0.1"
                                                               Color="Color.Primary"
                                                               Variant="Variant.Filled"
                                                               ValueChanged="OnTimelineChanged"
                                                               Style="width: 100%;" />
                                    
                                                    <!-- Event trigger marker -->
                                                    @{
                                                        var eventTriggerSeconds = GetEventTriggerSeconds();
                                                    }
                                                    @if (eventTriggerSeconds.HasValue && videoDuration > 0)
                                                    {
                                                        var eventPosition = (eventTriggerSeconds.Value / videoDuration) * 100;
                                                        <button type="button"
                                                                class="event-trigger-marker"
                                                                style="left: @(eventPosition.ToString(CultureInfo.InvariantCulture))%;"
                                                                title="Jump to event"
                                                                aria-label="Jump to event trigger"
                                                                @onclick="JumpToEventTrigger">
                                                            <span class="event-trigger-line"></span>
                                                            <span class="event-trigger-caret"></span>
                                                        </button>
                                                    }
                                    
                                                    <!-- Time markers -->
                                                    <div class="timeline-markers" style="display: flex; justify-content: space-between; margin-top: 2px; padding: 0 6px;">
                                                        @for (int i = 0; i <= GetTimeMarkerCount(); i++)
                                                        {
                                                            var markerTime = (videoDuration / GetTimeMarkerCount()) * i;
                                                            <MudText Typo="Typo.caption" Class="timeline-marker" Style="font-size: 9px; color: rgba(255,255,255,0.6);">
                                                                @FormatTimeWithTimestamp(markerTime)
                                                            </MudText>
                                                        }
                                                    </div>
                                                </div>
                                            </MudStack>
                                        </MudPaper>
                                    </MudItem>
                                }
                            </MudGrid>

                            <!-- Event Navigation (mobile) -->
                            <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="true">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudButton OnClick="NavigateToPreviousEvent"
                                               Disabled="@(!HasPreviousEvent())"
                                               Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.NavigateBefore">
                                        Prev
                                    </MudButton>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @(_filteredEvents.FindIndex(e => e.Event.Id == _selectedEvent!.Event.Id) + 1) / @_filteredEvents.Count
                                    </MudText>
                                    <MudButton OnClick="NavigateToNextEvent"
                                               Disabled="@(!HasNextEvent())"
                                               Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               EndIcon="@Icons.Material.Filled.NavigateNext">
                                        Next
                                    </MudButton>
                                </MudStack>
                            </MudHidden>

                            <!-- Row 2: Camera Videos -->
                            @if (cameras != null && cameras.Count > 0)
                            {
                                <MudGrid>
                                    @foreach (var slot in CameraSlots)
                                    {
                                        var camera = GetCameraByName(slot.Key);
                                        if (camera is null)
                                        {
                                            continue;
                                        }

                                        var isEventCamera = IsEventCamera(slot.Key);
                                        var borderStyle = isEventCamera ? "border: 3px solid red;" : "";
                                        <MudItem xs="12" md="6">
                                            <MudPaper Class="pa-2" Elevation="3" Style="@borderStyle">
                                                <MudStack Spacing="1">
                                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                                        <MudText Typo="Typo.subtitle1" Align="Align.Center" Style="font-weight: 600;">@slot.Title</MudText>
                                                        <MudStack Row="true" Spacing="0">
                                                            <MudIconButton Icon="@Icons.Material.Filled.Fullscreen"
                                                                           Size="Size.Small"
                                                                           title="Fullscreen this camera"
                                                                           aria-label="@($"Fullscreen {slot.Title}")"
                                                                           OnClick="@(() => FullscreenCamera(slot.Key))" />
                                                            <MudButton Href="@GetVideoUrl(camera)"
                                                                       Variant="Variant.Text"
                                                                       Size="Size.Small"
                                                                       StartIcon="@Icons.Material.Filled.Download"
                                                                       download="@GetDownloadFileName(slot.Key)">
                                                                <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="false"><span>Download</span></MudHidden>
                                                            </MudButton>
                                                        </MudStack>
                                                    </MudStack>
                                                    <video @key="@($"{slot.Key}-{camera.Id}")"
                                                           id="@($"video-{slot.Key}")"
                                                           src="@GetVideoUrl(camera)"
                                                           controls
                                                           playsinline
                                                           preload="metadata"
                                                           class="@($"camera-video{(isEventCamera ? " event-camera" : "")}")"
                                                           style="width: 100%; border-radius: 6px; background: #000;"
                                                           data-camera="@slot.Key"
                                                           data-offset="@GetCameraOffsetSeconds(camera)"
                                                           title="Double-click for fullscreen">
                                                        Your browser does not support the video tag.
                                                    </video>
                                                </MudStack>
                                            </MudPaper>
                                        </MudItem>
                                    }
                                </MudGrid>
                            }
                            else
                            {
                                <MudPaper Class="pa-8" Elevation="3">
                                    <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                        <MudIcon Icon="@Icons.Material.Filled.Videocam" Size="Size.Large" Color="Color.Secondary" />
                                        <MudText Typo="Typo.h6" Color="Color.Secondary">No cameras available for this event</MudText>
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>
                    }
                }
                else
                {
                    <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="false">
                        <MudPaper Class="pa-8" Elevation="3">
                            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Large" Color="Color.Secondary" />
                                <MudText Typo="Typo.h6" Color="Color.Secondary">Select an event to view cameras</MudText>
                            </MudStack>
                        </MudPaper>
                    </MudHidden>
                }
            </MudItem>
        </MudGrid>
    }
</MudContainer>
